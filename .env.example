# Copy to .env.local and fill in values (never commit .env.local)

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./dev.db
# Production: postgresql+psycopg2://listing:password@localhost:5432/listing
DB_PASSWORD=listing_dev

# ── Redis (leave empty to disable rate limiting in development) ───────────────
REDIS_URL=

# ── JWT — generate: python3 -c "import secrets; print(secrets.token_hex(32))" ─
JWT_SECRET_KEY=changeme-in-production-at-least-32-chars
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# ── Metrics ───────────────────────────────────────────────────────────────────
METRICS_HMAC_KEY=changeme-metrics-key

# ── Email 2FA (OTP) + SMTP ────────────────────────────────────────────────────
# OTP_2FA_ENABLED gates email 2FA for admin/agent logins. Leave false until SMTP
# is configured and a real login has been tested (avoids locking staff out).
OTP_2FA_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false

# ── Site & CDN ────────────────────────────────────────────────────────────────
SITE_URL=http://localhost:5173
CDN_BASE_URL=http://localhost:8000/static

# ── Storage: "local" (default) or "s3" ───────────────────────────────────────
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=temp/uploads

# S3 (only when STORAGE_BACKEND=s3)
# S3_BUCKET=my-listing-bucket
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# ── SonarQube (used by sonar_local.sh / make sonar-check) ────────────────────
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=
